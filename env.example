# Database Configuration
MONGODB_URI=mongodb://localhost:27017/wordeth
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/wordeth

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# Social Authentication
# Twitter/X OAuth
TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret
TWITTER_CALLBACK_URL=http://localhost:3000/api/auth/twitter/callback

# Instagram OAuth
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_CALLBACK_URL=http://localhost:3000/api/auth/instagram/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Lyrics API (Genius - Free and Reliable)
GENIUS_ACCESS_TOKEN=your_genius_access_token

# Production URLs
PRODUCTION_URL=https://your-domain.com
CLIENT_URL=http://localhost:3000

# Security
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=your-session-secret-key
