# Production Environment Variables
# Copy this to .env.production and fill in real values
# NEVER commit .env.production to git

# ==========================================
# CORE CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3000

# ==========================================
# SECURITY (REQUIRED - Use strong random values)
# ==========================================
# Generate: openssl rand -base64 64
JWT_SECRET=your-super-strong-jwt-secret-key-minimum-64-characters-long-use-openssl-rand-base64-64
SESSION_SECRET=your-super-strong-session-secret-key-minimum-64-characters-long-use-openssl-rand-base64-64

# ==========================================
# DATABASE (REQUIRED)
# ==========================================
# MongoDB Atlas connection string with SSL
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/wordeth?retryWrites=true&w=majority&ssl=true

# ==========================================
# API KEYS (REQUIRED)
# ==========================================
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# ==========================================
# URLS (REQUIRED)
# ==========================================
PRODUCTION_URL=https://yourdomain.com
CLIENT_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# ==========================================
# SOCIAL AUTHENTICATION (OPTIONAL)
# ==========================================
# Twitter/X OAuth
TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret
TWITTER_CALLBACK_URL=https://yourdomain.com/api/auth/twitter/callback

# Instagram OAuth
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_CALLBACK_URL=https://yourdomain.com/api/auth/instagram/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://yourdomain.com/api/auth/facebook/callback

# ==========================================
# OPTIONAL CONFIGURATION
# ==========================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session configuration
SESSION_MAX_AGE=86400000

# File upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/wordeth/app.log

