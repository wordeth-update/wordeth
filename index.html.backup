<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wordeth - Social Music Experience</title>
            <link rel="icon" type="image/png" href="images/logo.png">
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/animations.css">
</head>
<body>
    <nav class="main-nav">
        <div class="nav-logo">
            <a href="/">
                <img src="images/logo.png" alt="Wordeth Logo" class="logo">
            </a>
        </div>
        <div class="nav-links">
            <a href="video-rooms.html">Video Rooms</a>
            <a href="lyrics.html">Lyrics</a>
            <a href="merch.html">Merch</a>
        </div>
        <div class="search-container">
            <input type="text" placeholder="Search a song..." class="search-input">
            <button class="search-button">
                <img src="assets/mic-icon.svg" alt="Search" class="mic-icon">
            </button>
        </div>
        <div class="nav-auth">
            <button class="nav-signin-btn">Sign In</button>
        </div>
        <button class="menu-toggle">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </nav>

    <main>
        <section class="hero-section">
            <div class="hero-content">
                <h1>Connect Through Music</h1>
                <p>Join video calls, discover lyrics, and create custom merch with your favorite songs.</p>
                <div class="hero-buttons">
                    <a href="video-rooms.html" class="primary-button">Join Video Room</a>
                    <a href="lyrics.html" class="secondary-button">Search Lyrics</a>
                </div>
                <div class="social-login-options">
                    <p>Or sign in with:</p>
                    <button class="social-login-btn x"><i class="fab fa-twitter"></i></button>
                    <button class="social-login-btn instagram"><i class="fab fa-instagram"></i></button>
                    <button class="social-login-btn facebook"><i class="fab fa-facebook-f"></i></button>
                </div>
            </div>
        </section>

        <section class="featured-section">
            <h2>Featured Articles</h2>
            <div class="featured-grid" id="featured-articles">
                <!-- Articles will be dynamically loaded here -->
                <div class="loading-articles">
                    <div class="loading-spinner"></div>
                    <p>Loading latest hip-hop news...</p>
                </div>
            </div>
        </section>

        <section class="video-call-preview">
            <h2>Live Video Discussions</h2>
            <div class="preview-content">
                <div class="preview-info">
                    <h3>Connect with Music Lovers</h3>
                    <p>Join up to 6 people in live video discussions about your favorite songs.</p>
                    <a href="video-rooms.html" class="cta-button">Start a Call</a>
                </div>
                <div class="preview-image">
                    <img src="assets/video-preview.jpg" alt="Video Call Preview">
                </div>
            </div>
        </section>

        <section class="lyrics-preview">
            <h2>Find Your Lyrics</h2>
            <div class="genre-grid">
                <div class="genre-card">
                    <i class="fas fa-music"></i>
                    <h3>Hip Hop</h3>
                    <a href="lyrics.html?genre=hiphop" class="genre-link">Explore</a>
                </div>
                <div class="genre-card">
                    <i class="fas fa-guitar"></i>
                    <h3>Rock</h3>
                    <a href="lyrics.html?genre=rock" class="genre-link">Explore</a>
                </div>
                <div class="genre-card">
                    <i class="fas fa-star"></i>
                    <h3>Pop</h3>
                    <a href="lyrics.html?genre=pop" class="genre-link">Explore</a>
                </div>
                <div class="genre-card">
                    <i class="fas fa-heart"></i>
                    <h3>R&B</h3>
                    <a href="lyrics.html?genre=rnb" class="genre-link">Explore</a>
                </div>
            </div>
        </section>

        <section class="merch-preview">
            <h2>Custom Merch</h2>
            <div class="merch-grid">
                <div class="merch-item">
                    <img src="assets/tshirt-preview.png" alt="T-Shirt">
                    <h3>T-Shirts</h3>
                </div>
                <div class="merch-item">
                    <img src="assets/hat-preview.png" alt="Hat">
                    <h3>Hats</h3>
                </div>
                <div class="merch-item">
                    <img src="assets/beanie-preview.png" alt="Beanie">
                    <h3>Beanies</h3>
                </div>
                <div class="merch-item">
                    <img src="assets/tote-preview.png" alt="Tote Bag">
                    <h3>Tote Bags</h3>
                </div>
            </div>
            <a href="merch.html" class="cta-button">Design Your Merch</a>
        </section>
    </main>

    <footer>
        <div class="footer-content">
            <div class="footer-logo">
                <img src="images/logo.png" alt="Wordeth Logo">
            </div>
            <div class="social-links">
                <a href="#" class="social-icon twitter"></a>
                <a href="#" class="social-icon facebook"></a>
                <a href="#" class="social-icon spotify"></a>
            </div>
            <p class="copyright">Copyright — 2017</p>
        </div>
    </footer>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="js/main.js"></script>
    <script src="js/animations.js"></script>
    <script src="js/articles.js"></script>
</body>
</html> 