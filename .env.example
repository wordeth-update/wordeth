# ---------------------------------------------------------------------------
# Wordeth environment. Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Long random string (>= 64 chars). Signs user JWTs AND Lyric IQ guest tokens.
JWT_SECRET=replace-with-a-long-random-secret-openssl-rand-base64-64
JWT_EXPIRES_IN=7d

# --- Database --------------------------------------------------------------
# Either Atlas credentials (production) ...
MONGODB_USERNAME=
MONGODB_PASSWORD=
# ... or a full connection string for local development / other hosts.
MONGODB_URI=mongodb://127.0.0.1:27017/wordeth
MONGODB_URI_PROD=

# --- Lyric providers -------------------------------------------------------
# Musixmatch is the licensed lyric provider for Lyric IQ and lyric search.
MUSIXMATCH_API_KEY=
# Lyric IQ catalog source: musixmatch | synthetic
# Defaults to musixmatch when MUSIXMATCH_API_KEY is set, otherwise synthetic.
# The synthetic catalog is fabricated TEST CONTENT and is never real lyrics.
LYRICIQ_LYRIC_PROVIDER=synthetic
# Merge the synthetic catalog into gameplay (defaults to true outside production).
LYRICIQ_INCLUDE_SYNTHETIC=true
GENIUS_ACCESS_TOKEN=
YOUTUBE_API_KEY=

# --- play.wordeth.com ------------------------------------------------------
# Host that serves the Lyric IQ page at "/" (comma-separate extra hosts). Point a
# CNAME for it at the same Railway service and add it as a custom domain there.
LYRICIQ_PLAY_HOST=play.wordeth.com
# Public base URL used in share text and challenge links (defaults to the play host).
LYRICIQ_PUBLIC_URL=https://play.wordeth.com
# Share sign-in between wordeth.com and play.wordeth.com via a cookie on this domain.
# Leave empty to keep the old localStorage-only behaviour.
AUTH_COOKIE_DOMAIN=.wordeth.com

# --- Lyric IQ --------------------------------------------------------------
# Shared key for /api/internal/* content controls (admin JWTs also work).
LYRICIQ_INTERNAL_API_KEY=
# Private salt so Daily 10 sets cannot be precomputed by outsiders.
LYRICIQ_DAILY_SEED_SALT=
# Licence-driven cache limits (ms). Lyric bodies default to 1 hour.
LYRICIQ_CACHE_LYRIC_TTL_MS=3600000
LYRICIQ_CACHE_TRACK_TTL_MS=86400000
# Provider timeout and generation budget.
LYRICIQ_PROVIDER_TIMEOUT_MS=8000
LYRICIQ_MAX_GENERATION_ATTEMPTS=12
# Session lifecycle.
LYRICIQ_QUESTION_TTL_MS=180000
LYRICIQ_SESSION_IDLE_EXPIRY_MS=1800000
LYRICIQ_GUEST_TOKEN_TTL=30d
# Minimum answered questions before a category sub-score is shown.
LYRICIQ_MIN_CATEGORY_QUESTIONS=15
# Set to 1 to print structured Lyric IQ logs during jest runs.
# LYRICIQ_TEST_LOGS=1

# --- Optional platform services -------------------------------------------
REDIS_URL=
CLIENT_URL=
CORS_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
COMING_SOON_MODE=off
COMING_SOON_PREVIEW_TOKEN=
PUPPETEER_EXECUTABLE_PATH=
