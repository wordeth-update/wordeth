modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0"]

[userenv]

[userenv.shared]
NODE_ENV = "development"
PORT = "5000"
JWT_SECRET = "1a7c40046c7d7aa62490768869490de09cbc7911e017470a2e5a0fecab7715e9cc12e7166638b5e2e7038c3497d70a8803e70128e648bbf388c5ec06c7db0311"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Wordeth Server"

[[workflows.workflow]]
name = "Wordeth Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]
