{
  "appId": "com.wordeth.app",
  "appName": "Wordeth",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#000000",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#000000"
    },
    "Camera": {
      "presentationStyle": "fullscreen"
    }
  }
}
