<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wordeth - Social Music Experience</title>
            <link rel="icon" type="image/png" href="images/logo.png">
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/animations.css">
</head>
<body>
    <nav class="main-nav">
        <div class="nav-logo">
            <a href="/">
                <img src="images/logo.png" alt="Wordeth Logo" class="logo">
            </a>
        </div>
        <div class="nav-links">
            <a href="video-rooms.html">Video Rooms</a>
            <a href="lyrics.html">Lyrics</a>
            <a href="merch.html">Merch</a>
        </div>
        <div class="search-container">
            <input type="text" placeholder="Search a song..." class="search-input">
            <button class="search-button">
                <img src="assets/mic-icon.svg" alt="Search" class="mic-icon">
            </button>
        </div>
        <div class="nav-auth">
            <button class="nav-signin-btn">Sign In</button>
        </div>
        <button class="menu-toggle">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </nav>

    <main>
        <section class="hero-section">
            <div class="hero-content">
                <h1>Connect Through Music</h1>
                <p>Join video calls, discover lyrics, and create custom merch with your favorite songs.</p>
                <div class="hero-buttons">
                    <a href="video-rooms.html" class="primary-button">Join Video Room</a>
                    <a href="lyrics.html" class="secondary-button">Search Lyrics</a>
                </div>
                <div class="social-login-options">
                    <p>Or sign in with:</p>
                    <button class="social-login-btn x"><i class="fab fa-twitter"></i></button>
                    <button class="social-login-btn instagram"><i class="fab fa-instagram"></i></button>
                    <button class="social-login-btn facebook"><i class="fab fa-facebook-f"></i></button>
                </div>
            </div>
        </section>

        <section class="featured-section">
            <h2>Featured Articles</h2>
            <div class="featured-grid" id="featured-articles">
                <!-- Articles will be dynamically loaded here -->
                <div class="loading-articles">
                    <div class="loading-spinner"></div>
                    <p>Loading latest hip-hop news...</p>
                </div>
            </div>
        </section>

        <section class="video-call-preview">
            <div class="video-preview-container">
                <div class="video-preview-content">
                    <div class="video-preview-info">
                        <div class="video-preview-badge">
                            <i class="fas fa-video"></i>
                            <span>Live Now</span>
                        </div>
                        <h2>Connect Through Music</h2>
                        <h3>Join Live Video Discussions</h3>
                        <p>Experience the power of music together. Join up to 6 people in real-time video discussions about your favorite songs, share lyrics, and discover new artists with fellow music enthusiasts.</p>
                        <div class="video-features">
                            <div class="feature-item">
                                <i class="fas fa-users"></i>
                                <span>Up to 6 People</span>
                            </div>
                            <div class="feature-item">
                                <i class="fas fa-music"></i>
                                <span>Music Sharing</span>
                            </div>
                            <div class="feature-item">
                                <i class="fas fa-comments"></i>
                                <span>Live Chat</span>
                            </div>
                        </div>
                        <a href="video-rooms.html" class="video-cta-button">
                            <i class="fas fa-play"></i>
                            Start a Discussion
                        </a>
                    </div>
                    <div class="video-preview-visual">
                        <div class="video-preview-image">
                            <img src="https://images.unsplash.com/photo-1516280440614-37939bbacd81?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80" alt="Music Studio Collaboration">
                            <div class="video-overlay">
                                <div class="video-play-button">
                                    <i class="fas fa-play"></i>
                                </div>
                            </div>
                        </div>
                        <div class="video-stats">
                            <div class="stat-item">
                                <span class="stat-number">2.5K+</span>
                                <span class="stat-label">Active Users</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number">500+</span>
                                <span class="stat-label">Daily Calls</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number">50K+</span>
                                <span class="stat-label">Songs Shared</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="lyrics-preview">
            <h2>Find Your Lyrics</h2>
            <div class="genre-grid">
                <div class="genre-card">
                    <i class="fas fa-music"></i>
                    <h3>Hip Hop</h3>
                    <a href="lyrics.html?genre=hiphop" class="genre-link">Explore</a>
                </div>
                <div class="genre-card">
                    <i class="fas fa-guitar"></i>
                    <h3>Rock</h3>
                    <a href="lyrics.html?genre=rock" class="genre-link">Explore</a>
                </div>
                <div class="genre-card">
                    <i class="fas fa-star"></i>
                    <h3>Pop</h3>
                    <a href="lyrics.html?genre=pop" class="genre-link">Explore</a>
                </div>
                <div class="genre-card">
                    <i class="fas fa-heart"></i>
                    <h3>R&B</h3>
                    <a href="lyrics.html?genre=rnb" class="genre-link">Explore</a>
                </div>
            </div>
        </section>

        <section class="merch-preview">
            <h2>Custom Merch</h2>
            <div class="merch-grid">
                <div class="merch-item">
                    <img src="assets/tshirt-preview.png" alt="T-Shirt">
                    <h3>T-Shirts</h3>
                </div>
                <div class="merch-item">
                    <img src="assets/hat-preview.png" alt="Hat">
                    <h3>Hats</h3>
                </div>
                <div class="merch-item">
                    <img src="assets/beanie-preview.png" alt="Beanie">
                    <h3>Beanies</h3>
                </div>
                <div class="merch-item">
                    <img src="assets/tote-preview.png" alt="Tote Bag">
                    <h3>Tote Bags</h3>
                </div>
            </div>
            <a href="merch.html" class="cta-button">Design Your Merch</a>
        </section>
    </main>

    <footer>
        <div class="footer-content">
            <div class="footer-logo">
                <img src="images/logo.png" alt="Wordeth Logo">
            </div>
            <div class="social-links">
                <a href="#" class="social-icon twitter"></a>
                <a href="#" class="social-icon facebook"></a>
                <a href="#" class="social-icon spotify"></a>
            </div>
            <p class="copyright">Copyright — 2017</p>
        </div>
    </footer>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="js/main.js"></script>
    <script src="js/animations.js"></script>
    <script src="js/articles.js"></script>
</body>
</html> 